<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Navegador Web" android:textSize="20sp" android:textStyle="bold"
        android:textColor="@color/green_dark"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <EditText android:id="@+id/campo_direccion_web" android:layout_width="0dp"
            android:layout_height="48dp" android:layout_weight="1" android:hint="Ingresa la dirección URL"
            android:inputType="textUri"/>
        <Button android:id="@+id/btn_cargar_web" android:layout_width="90dp"
            android:layout_height="48dp" android:text="Cargar"/>
    </LinearLayout>
    <WebView android:id="@+id/vista_web" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:layout_marginBottom="12dp"/>
    <Button android:id="@+id/btn_devolver_web" android:layout_width="match_parent"
        android:layout_height="52dp" android:text="Devolver al menú principal"/>
</LinearLayout>
