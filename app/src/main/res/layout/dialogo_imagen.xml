<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#000000">
    <com.github.chrisbanes.photoview.PhotoView android:id="@+id/imagen_zoom"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:scaleType="fitCenter"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center">
        <Button android:id="@+id/btn_imagen_mas" android:layout_width="70dp"
            android:layout_height="70dp" android:text="+" android:textSize="26sp"/>
        <Button android:id="@+id/btn_imagen_menos" android:layout_width="70dp"
            android:layout_height="70dp" android:text="-" android:textSize="26sp"/>
    </LinearLayout>
    <Button android:id="@+id/btn_cerrar_imagen" android:layout_width="match_parent"
        android:layout_height="55dp" android:text="Cerrar y volver"/>
</LinearLayout>
