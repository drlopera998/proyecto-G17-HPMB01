<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Información" android:textSize="20sp" android:textStyle="bold"
        android:textColor="@color/green_dark"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <TextView android:id="@+id/txt_informacion" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="16sp"
            android:lineSpacingExtra="5dp" android:textColor="#333333" android:padding="10dp"
            android:text="Información sobre la creación de muebles."/>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center">
        <Button android:id="@+id/btn_agrandar_texto" android:layout_width="60dp"
            android:layout_height="60dp" android:text="+" android:textSize="24sp"/>
        <Button android:id="@+id/btn_reducir_texto" android:layout_width="60dp"
            android:layout_height="60dp" android:text="-" android:textSize="24sp"/>
    </LinearLayout>

    <Button android:id="@+id/btn_devolver_perfil" android:layout_width="match_parent"
        android:layout_height="52dp" android:text="Devolver al menú principal"/>
</LinearLayout>
