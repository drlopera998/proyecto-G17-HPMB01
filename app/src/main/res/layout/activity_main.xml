<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_background">

    <TextView
        android:id="@+id/txt_header"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="center"
        android:background="@color/green_header"
        android:text="CREACIÓN DE MUEBLES"
        android:textColor="@android:color/white"
        android:textSize="17sp"
        android:textStyle="bold"
        android:letterSpacing="0.03" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/layout_menu_lateral"
            android:layout_width="104dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="7dp"
            android:paddingTop="12dp"
            android:paddingEnd="7dp"
            android:background="@color/menu_background">

            <Button
                android:id="@+id/btn_menu"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginBottom="7dp"
                android:background="@drawable/bg_menu_header"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="MENÚ ☰"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_menu_perfil"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_menu_button_active"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="Perfil"
                android:textAllCaps="false"
                android:textColor="@color/text_dark"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_menu_fotos"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_menu_button"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="Fotos"
                android:textAllCaps="false"
                android:textColor="@color/text_dark"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_menu_videos"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_menu_button"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="Videos"
                android:textAllCaps="false"
                android:textColor="@color/text_dark"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_menu_web"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_menu_button"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="Web"
                android:textAllCaps="false"
                android:textColor="@color/text_dark"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_menu_botones"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_menu_button"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="Botones"
                android:textAllCaps="false"
                android:textColor="@color/text_dark"
                android:textSize="12sp" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/contenedor_fragmentos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/content_background" />

    </LinearLayout>
</LinearLayout>
